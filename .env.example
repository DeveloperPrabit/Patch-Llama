# Auth.js — required for any mutating API (min 32 chars; never use placeholder in production)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Production requires GitHub OAuth:
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Local/demo only (disabled when NODE_ENV=production). Requires BOTH flags:
PATCHLLAMA_MODE=demo
AUTH_DEMO_LOGIN=1

# Meta Muse Spark
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Isolation (required for baseline/verify — fail closed if Docker unhealthy)
PATCHLLAMA_DOCKER_IMAGE=oven/bun:1.2
PATCHLLAMA_DOCKER_MEMORY=512m
PATCHLLAMA_DOCKER_CPUS=1
PATCHLLAMA_DOCKER_PIDS=128
PATCHLLAMA_EXEC_TIMEOUT_MS=60000
PATCHLLAMA_WORKSPACE_ROOT=

# Storage: json = local/demo only; set DATABASE_URL for hosted multi-user Postgres
PATCHLLAMA_STORAGE=json
DATABASE_URL=

# Optional
PATCHLLAMA_MAX_BODY_BYTES=1500000
PATCHLLAMA_MAX_REPAIR_ATTEMPTS=2
RUN_LIVE_META=0
