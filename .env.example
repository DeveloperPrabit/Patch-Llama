# Auth.js — required for any mutating API (min 32 chars; never use placeholder in production)
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Production requires GitHub OAuth:
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Local/demo only (disabled when NODE_ENV=production). Requires BOTH flags:
PATCHLLAMA_MODE=demo
AUTH_DEMO_LOGIN=1

# Meta Muse Spark
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.3

# Isolation (required for baseline/verify — fail closed if Docker unhealthy)
PATCHLLAMA_DOCKER_IMAGE=oven/bun:1.2
PATCHLLAMA_DOCKER_MEMORY=512m
PATCHLLAMA_DOCKER_CPUS=1
PATCHLLAMA_DOCKER_PIDS=128
PATCHLLAMA_EXEC_TIMEOUT_MS=60000
PATCHLLAMA_WORKSPACE_ROOT=

# ---------------------------------------------------------------------------
# Storage (Neon PostgreSQL)
# ---------------------------------------------------------------------------
# Hosted / production: PATCHLLAMA_STORAGE=postgres (default when NODE_ENV=production)
# Local/demo only:     PATCHLLAMA_STORAGE=json
#
# Production NEVER falls back to JSON. Missing DATABASE_URL fails closed.
PATCHLLAMA_STORAGE=json

# Neon pooled connection string (app runtime / serverless). Prefer the pooler host.
# Example placeholder only — never commit real credentials:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Optional direct (unpooled) URL for drizzle-kit migrate when pooler rejects DDL:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=

# Optional pool size for postgres.js (default 10)
# DATABASE_POOL_MAX=10

# Opt-in Neon integration tests (dedicated test DB only — never production):
# PATCHLLAMA_TEST_DATABASE_URL=
# PATCHLLAMA_RUN_DB_TESTS=1

# Optional
PATCHLLAMA_MAX_BODY_BYTES=1500000
PATCHLLAMA_MAX_REPAIR_ATTEMPTS=2
PATCHLLAMA_DATA_DIR=
RUN_LIVE_META=0
